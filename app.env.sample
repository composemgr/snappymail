# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=snappymail.example.com

# Print the container startup script trace to the logs
SNAPPYMAIL_DEBUG=false

# Largest attachment a user may send, PHP upload limit
SNAPPYMAIL_UPLOAD_MAX_SIZE=25M

# Per request memory limit for PHP-FPM
SNAPPYMAIL_MEMORY_LIMIT=128M

# Send session cookies only over HTTPS. Set to false if you access the
# webmail over plain HTTP on the docker bridge address.
SNAPPYMAIL_SECURE_COOKIES=true
